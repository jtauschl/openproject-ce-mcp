#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
shift || true

# A stale uv.lock must fail every uv command of the gate, not be re-locked silently.
export UV_LOCKED=1

usage() {
    echo "Usage: ./dev {bootstrap|lint|licenses|semgrep|shell-lint|test|test-lowest|build|dist|dist-check|editable-check|sbom|ci}" >&2
    exit 1
}

# The project's own editable install is built without build isolation, with the hatchling of the `build` dependency group, which
# uv.lock pins and hashes. Isolated, uv would resolve the backend of [build-system] from PyPI at run time, and uv has no
# build-constraints option for `sync` and `run`. The flag names the one package, because UV_NO_BUILD_ISOLATION would reach
# `uv build` and its --build-constraints too. Every other `uv run` of the project passes --no-sync, since a sync would build
# the project isolated again.
sync_project() {
    uv sync --locked --dev --group build --no-build-isolation-package openproject-ce-mcp "$@"
}

bootstrap() {
    sync_project "$@"
}

shell_scripts=(dev docker/test/up.sh docker/test/down.sh tools/api-check/fetch-sources.sh tools/install-mcp-publisher.sh tools/install-semgrep-rules.sh tools/install-shfmt.sh)
required_shfmt_version="3.14.1"

shell_lint() {
    shellcheck "${shell_scripts[@]}"
    local actual_shfmt_version
    # A `go install` build prints a leading "v", a Homebrew build does not.
    actual_shfmt_version="$(shfmt --version)"
    actual_shfmt_version="${actual_shfmt_version#v}"
    if [ "$actual_shfmt_version" != "$required_shfmt_version" ]; then
        echo "shfmt $required_shfmt_version required; found $actual_shfmt_version" >&2
        exit 1
    fi
    shfmt -l "${shell_scripts[@]}"
    for f in "${shell_scripts[@]}"; do
        bash -n "$f"
    done
}

# bandit, semgrep, twine and pip-licenses come from their own locked project (tools/lint), so their versions and hashes are
# fixed by tools/lint/uv.lock and they stay out of the shipped package's license gate and SBOM.
lint_tool() {
    uv run --project tools/lint --locked "$@"
}

# pip-licenses is pinned because tools/check_licenses.py allow-lists the exact strings it prints. The gate builds its own
# environment from the lock file, so it checks every extra and group on every run, whatever .venv holds. The EXIT trap
# removes that environment (about 130 MB) when the run is interrupted.
licenses() {
    local status=0
    licenses_dir="$(mktemp -d)"
    trap 'rm -rf "${licenses_dir:-}"' EXIT
    {
        UV_PROJECT_ENVIRONMENT="$licenses_dir/venv" sync_project --all-extras --all-groups --quiet &&
            lint_tool pip-licenses --python "$licenses_dir/venv/bin/python3" --from=mixed --format=json --output-file "$licenses_dir/licenses.json" >/dev/null &&
            "$licenses_dir/venv/bin/python3" tools/check_licenses.py "$licenses_dir/licenses.json"
    } || status=$?
    rm -rf "$licenses_dir"
    return "$status"
}

# The rules are the handbook's Python packs at a pinned commit of semgrep-rules (tools/install-semgrep-rules.sh); `--config auto`
# would fetch whatever the registry serves today and refuses `--metrics off`.
semgrep() {
    local status=0
    semgrep_rules_dir="$(mktemp -d)"
    trap 'rm -rf "${semgrep_rules_dir:-}"' EXIT
    {
        tools/install-semgrep-rules.sh "$semgrep_rules_dir" &&
            lint_tool semgrep scan --config "$semgrep_rules_dir" --error --strict --metrics off --disable-version-check src/openproject_ce_mcp
    } || status=$?
    rm -rf "$semgrep_rules_dir"
    return "$status"
}

lint() {
    sync_project --quiet
    uv run --no-sync ruff check .
    uv run --no-sync ruff format --check .
    uv run --no-sync mypy
    lint_tool bandit -r src/openproject_ce_mcp -ll
    semgrep
    licenses
    shell_lint
    if ! command -v actionlint >/dev/null 2>&1; then
        echo "actionlint not found — install: go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12" >&2
        exit 1
    fi
    actionlint
}

test_() {
    sync_project --quiet
    # Separate floors so well-covered client code cannot carry untested audit tooling.
    uv run --no-sync pytest --cov=src/openproject_ce_mcp --cov=tools --cov-report= --cov-fail-under=0 "$@"
    uv run --no-sync coverage report --include='*/src/openproject_ce_mcp/*' --fail-under=88
    uv run --no-sync coverage report --include='*/tools/*' --fail-under=85
    # The client wraps httpx internals, so the lowest supported httpx minor is tested too.
    uv run --no-sync --with 'httpx[socks]==0.27.*' pytest -q -p no:cacheprovider \
        tests/unit/test_client_http_stack.py tests/unit/test_app_httpx_transport.py tests/test_retry_transport.py
}

# A test that passes on the newest interpreter can still break on the lowest one (annotation introspection differs), and
# only the CI matrix would see it. The floor is read from requires-python, the single place that states it, and the tests
# run in a separate environment that only this step creates, so `./dev bootstrap` and the CI jobs never build it.
test_lowest() {
    local floor
    floor=$(sed -n 's/^requires-python = ">=\([0-9][0-9]*\.[0-9][0-9]*\)"$/\1/p' pyproject.toml)
    if [ -z "$floor" ]; then
        echo "requires-python in pyproject.toml is not a plain lower bound; teach ./dev test-lowest to read it" >&2
        return 1
    fi
    # Set per command, never exported: the steps that follow in `./dev ci` use the normal environment.
    UV_PROJECT_ENVIRONMENT=.venv-lowest uv sync --locked --dev --group build \
        --no-build-isolation-package openproject-ce-mcp --python "$floor" --quiet
    UV_PROJECT_ENVIRONMENT=.venv-lowest uv run --no-sync --python "$floor" pytest -q -p no:cacheprovider "$@"
}

# The SBOM is exported from the lock file, so the project is its root component and the graph is complete.
# uv marks the format experimental; tools/check_sbom.py fails the build if a uv release changes what it needs.
sbom() {
    sync_project --quiet
    uv export --locked --no-dev --format cyclonedx1.5 --preview-features sbom-export -o sbom.json >/dev/null
    uv run --no-sync python tools/check_sbom.py sbom.json
}

# The distribution is built with the build backend of tools/build/uv.lock, exported as hashed build constraints. With
# `--require-hashes` uv refuses any build requirement, transitive ones included, that is not pinned with a matching hash.
# The constraints file is generated here and never committed, so the lock stays the only source. Anything after the name
# is passed to `uv build` (for example `--out-dir`).
dist() {
    (
        constraints="$(mktemp)"
        trap 'rm -f "$constraints"' EXIT
        uv export --project tools/build --locked --no-emit-project --no-header --format requirements-txt -o "$constraints" >/dev/null
        uv build --build-constraints "$constraints" --require-hashes "$@"
    )
}

# Every build proves the guarantee above is live: constraints that omit one dependency of the backend must make the build
# fail, and for the right reason. A uv release that stops enforcing the hashes turns this check red instead of letting an
# unhashed backend through.
dist_check() {
    (
        workdir="$(mktemp -d)"
        trap 'rm -rf "$workdir"' EXIT
        uv export --project tools/build --locked --no-emit-project --no-header --format requirements-txt -o "$workdir/all.txt" >/dev/null
        awk '/^pluggy==/ { skip = 1; next } skip && /^[[:space:]]/ { next } { skip = 0; print }' "$workdir/all.txt" >"$workdir/without-pluggy.txt"
        if grep -q '^pluggy' "$workdir/without-pluggy.txt" || ! grep -q '^hatchling==' "$workdir/without-pluggy.txt"; then
            echo "dist-check: could not remove exactly the pluggy pin from the exported constraints" >&2
            exit 1
        fi
        if uv build --sdist --out-dir "$workdir/out" --build-constraints "$workdir/without-pluggy.txt" --require-hashes \
            >"$workdir/build.log" 2>&1; then
            echo "dist-check: a build without the hash of pluggy succeeded; hash checking of build requirements is not enforced" >&2
            exit 1
        fi
        # The wording differs between uv releases ("all requirements must be pinned upfront with `==`, but found" in
        # 0.12, "Hash-checking is required, but no trusted hash was provided for" in 0.13); both name the package.
        if ! grep -qE '(pinned upfront with .==., but found|no trusted hash was provided for): .pluggy.' "$workdir/build.log"; then
            echo "dist-check: the build failed, but not because pluggy has no hash:" >&2
            cat "$workdir/build.log" >&2
            exit 1
        fi
    )
}

# Every build also proves the editable install really is built without isolation: without the `build` group the backend is not
# in the environment, so the same sync must fail. If it succeeded, uv would have resolved a backend from PyPI again (a uv
# release that ignores the flag, or the flag dropped from sync_project).
editable_check() {
    (
        workdir="$(mktemp -d)"
        trap 'rm -rf "$workdir"' EXIT
        export UV_PROJECT_ENVIRONMENT="$workdir/venv"
        if uv sync --locked --no-dev --no-build-isolation-package openproject-ce-mcp \
            --reinstall-package openproject-ce-mcp --refresh-package openproject-ce-mcp >"$workdir/sync.log" 2>&1; then
            echo "editable-check: the project was built without its backend in the environment; build isolation is not off" >&2
            exit 1
        fi
        # The backend's own import fails inside the build; a failed download of an isolated backend would not say this.
        if ! grep -q "ModuleNotFoundError: No module named 'hatchling'" "$workdir/sync.log"; then
            echo "editable-check: the build failed, but not because the backend is missing:" >&2
            cat "$workdir/sync.log" >&2
            exit 1
        fi
    )
}

build() {
    dist
    dist_check
    editable_check
    lint_tool twine check dist/*
    sbom
}

case "$cmd" in
bootstrap) bootstrap "$@" ;;
lint) lint ;;
licenses) licenses ;;
semgrep) semgrep ;;
shell-lint) shell_lint ;;
test) test_ "$@" ;;
test-lowest) test_lowest "$@" ;;
build) build ;;
dist) dist "$@" ;;
dist-check) dist_check ;;
editable-check) editable_check ;;
sbom) sbom ;;
ci)
    lint
    test_
    test_lowest
    build
    ;;
*) usage ;;
esac
