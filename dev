#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
shift || true

usage() {
    echo "Usage: ./dev {bootstrap|lint|test|build|ci}" >&2
    exit 1
}

bootstrap() {
    uv sync --dev
}

lint() {
    uv run ruff check .
    uv run ruff format --check .
    uv run mypy
    uvx bandit -r src/openproject_ce_mcp -ll
    uvx semgrep --config auto --error src/openproject_ce_mcp
    uvx pip-licenses --python .venv/bin/python3 --partial-match --fail-on="GPL;LGPL;AGPL"
    sh -n get.sh
    bash -n dev
    bash -n uninstall.sh
}

test_() {
    uv run pytest --cov=src/openproject_ce_mcp --cov-report=term-missing "$@"
}

build() {
    uv build
    uvx twine check dist/*
    uv export --no-dev --format requirements-txt --no-hashes -o requirements.txt
    uvx --from cyclonedx-bom cyclonedx-py requirements requirements.txt --of JSON -o sbom.json
}

case "$cmd" in
bootstrap) bootstrap ;;
lint) lint ;;
test) test_ "$@" ;;
build) build ;;
ci)
    lint
    test_
    build
    ;;
*) usage ;;
esac
