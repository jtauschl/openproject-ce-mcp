#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
shift || true

usage() {
    echo "Usage: ./dev {bootstrap|lint|test|build|ci|handbook-check}" >&2
    exit 1
}

bootstrap() {
    uv sync --dev
    ./scripts/sync-commit-msg-hook.sh
}

shell_scripts=(dev get.sh uninstall.sh docker/test/up.sh docker/test/down.sh tools/api-check/fetch-sources.sh tools/security-settings/github-security-settings.sh)

lint() {
    uv run ruff check .
    uv run ruff format --check .
    uv run mypy
    uvx bandit -r src/openproject_ce_mcp -ll
    uvx semgrep --config auto --error src/openproject_ce_mcp
    uvx pip-licenses --python .venv/bin/python3 --fail-on="GPL;LGPL;AGPL"
    shellcheck "${shell_scripts[@]}"
    shfmt -l "${shell_scripts[@]}"
    sh -n get.sh
    for f in dev uninstall.sh docker/test/up.sh docker/test/down.sh tools/api-check/fetch-sources.sh tools/security-settings/github-security-settings.sh; do
        bash -n "$f"
    done
    if ! command -v actionlint >/dev/null 2>&1; then
        echo "actionlint not found — install: go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12" >&2
        exit 1
    fi
    actionlint
}

test_() {
    uv run pytest --cov=src/openproject_ce_mcp --cov-report=term-missing "$@"
}

build() {
    uv build
    uvx twine check dist/*
    uv export --no-dev --format requirements-txt --no-hashes -o requirements.txt
    uvx --from cyclonedx-bom cyclonedx-py requirements requirements.txt --of JSON -o sbom.json
}

handbook_check() {
    ./scripts/handbook-check.sh "$@"
}

case "$cmd" in
bootstrap) bootstrap ;;
lint) lint ;;
test) test_ "$@" ;;
build) build ;;
ci)
    lint
    test_
    build
    ;;
handbook-check) handbook_check "$@" ;;
*) usage ;;
esac
