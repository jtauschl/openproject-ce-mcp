{
  // Scoped to docs/*.md and CHANGELOG.md -- this project's remaining
  // Markdown outside docs/ (including README.md) is not covered by
  // this config or by the cleanup pass that introduced it.
  "globs": ["docs/*.md", "CHANGELOG.md"],

  // MD013 (line-length) is unenforceable on GFM table rows -- a table cell
  // cannot wrap onto a second physical line without breaking the table
  // syntax, and this project's docs/*.md files use wide reference tables
  // (tool name + description) throughout. "tables: false" is markdownlint's
  // own documented escape hatch for exactly this case; prose lines outside
  // tables still get checked at the default 80-character limit.
  //
  // MD033 (no-inline-html) is restricted to allow only <p>/<img> -- the
  // <p align="center"><img .../></p> centered title-image block every
  // docs/*.md file opens with (plain Markdown has no way to center an
  // image; this is a deliberate, consistent convention across all 15
  // files, not stray HTML). Any other inline HTML still gets flagged.
  //
  // MD013's "code_blocks: false" exempts fenced code blocks -- this repo's
  // docs/architecture.md includes a hand-aligned ASCII directory-tree
  // diagram inside a ```text block; wrapping those lines at 80 chars would
  // destroy the alignment the diagram depends on.
  //
  // MD024's "siblings_only: true" allows the same heading text to repeat
  // across different parent sections -- CHANGELOG.md follows the Keep a
  // Changelog convention of a "### Added"/"### Fixed"/etc. heading under
  // every "## [x.y.z]" version section; without siblings_only, every
  // repeated section-name heading across ~40 version sections would flag as
  // a duplicate, even though each is scoped to its own version and repeating
  // the name is the whole point of the convention, not accidental
  // duplication.
  "config": {
    "MD013": {
      "line_length": 80,
      "tables": false,
      "code_blocks": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["p", "img"]
    }
  }
}
